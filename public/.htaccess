# SPA fallback for Hostinger / Apache hosts
# Routes like /admin, /track/:id are handled by React Router on the client.
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proxy /sitemap.xml to dynamic edge function
  RewriteRule ^sitemap\.xml$ https://frcxvkcodspezznsoxsl.supabase.co/functions/v1/sitemap [P,L]

  # Don't rewrite real files / directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
